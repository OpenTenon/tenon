# Generated by tools/generate_tier0.py. Do not edit manually.
# Sky130 package-to-PDN bridges for qfn88.
# The four rails are routed as separate special nets.
set ::tenon_sky130_bridge_die_area [list 0 0 2560 2560]
set ::tenon_sky130_bridge_core_area [list 365 365 2195 2195]

proc tenon_sky130_bridge_box {swire layer x0 y0 x1 y1} {
    set xlo [expr {min($x0, $x1)}]
    set xhi [expr {max($x0, $x1)}]
    set ylo [expr {min($y0, $y1)}]
    set yhi [expr {max($y0, $y1)}]
    odb::dbSBox_create $swire $layer $xlo $ylo $xhi $yhi STRIPE
}

proc tenon_sky130_bridge_horizontal {swire layer width x0 x1 y} {
    set half [expr {$width / 2}]
    tenon_sky130_bridge_box $swire $layer $x0 [expr {$y - $half}] $x1 [expr {$y + $half}]
}

proc tenon_sky130_bridge_vertical {swire layer width x y0 y1} {
    set half [expr {$width / 2}]
    tenon_sky130_bridge_box $swire $layer [expr {$x - $half}] $y0 [expr {$x + $half}] $y1
}

proc tenon_sky130_bridge_edge {x y die_x0 die_y0 die_x1 die_y1} {
    set edge SOUTH
    set distance [expr {$y - $die_y0}]
    foreach {candidate candidate_distance} [list \
        EAST [expr {$die_x1 - $x}] \
        NORTH [expr {$die_y1 - $y}] \
        WEST [expr {$x - $die_x0}]] {
        if {$candidate_distance < $distance} {
            set edge $candidate
            set distance $candidate_distance
        }
    }
    return $edge
}

proc tenon_sky130_attach_source {swire m3 m4 m5 m3m4 m4m5 width source_layer x y edge left bottom right top} {
    if {$source_layer eq "met3"} {
        odb::dbSBox_create $swire $m3m4 $x $y STRIPE
    }
    switch -- $edge {
        SOUTH - NORTH {
            if {$source_layer eq "met5"} {
                odb::dbSBox_create $swire $m4m5 $x $y STRIPE
            }
            set ring_y $bottom
            if {$edge eq "NORTH"} {
                set ring_y $top
            }
            tenon_sky130_bridge_vertical $swire $m4 $width $x $y $ring_y
            odb::dbSBox_create $swire $m4m5 $x $ring_y STRIPE
        }
        WEST - EAST {
            if {$source_layer ne "met5"} {
                odb::dbSBox_create $swire $m4m5 $x $y STRIPE
            }
            set ring_x $left
            if {$edge eq "EAST"} {
                set ring_x $right
            }
            tenon_sky130_bridge_horizontal $swire $m5 $width $x $ring_x $y
            odb::dbSBox_create $swire $m4m5 $ring_x $y STRIPE
        }
    }
}

proc tenon_sky130_attach_bterms {block net_name swire m3 m4 m5 m3m4 m4m5 width left bottom right top die_x0 die_y0 die_x1 die_y1} {
    foreach bterm [odb::dbBlock_getBTerms $block] {
        set bterm_net [$bterm getNet]
        if {$bterm_net eq "NULL" || [$bterm_net getName] ne $net_name} {
            continue
        }
        foreach bpin [$bterm getBPins] {
            foreach box [$bpin getBoxes] {
                set layer [$box getTechLayer]
                if {$layer eq "NULL" || [$layer getName] ne "met5"} {
                    continue
                }
                set x [expr {int(([$box xMin] + [$box xMax]) / 2)}]
                set y [expr {int(([$box yMin] + [$box yMax]) / 2)}]
                set edge [tenon_sky130_bridge_edge $x $y $die_x0 $die_y0 $die_x1 $die_y1]
                tenon_sky130_attach_source $swire $m3 $m4 $m5 $m3m4 $m4m5 $width met5 $x $y $edge $left $bottom $right $top
            }
    }
        }
}

proc tenon_sky130_attach_hvc {block net_name swire m3 m4 m5 m3m4 m4m5 width left bottom right top die_x0 die_y0 die_x1 die_y1} {
    set net [$block findNet $net_name]
    foreach iterm [$net getITerms] {
        set term_name [$iterm getName]
        if {![string match "*/DRN_HVC" $term_name] && ![string match "*/SRC_BDY_HVC" $term_name]} {
            continue
        }
        set instance_name [[$iterm getInst] getName]
        set is_hvc 0
        foreach pad_array {u_iovdd_pads u_iovss_pads u_vdd_pads u_vss_pads} {
            if {[string first $pad_array $instance_name] >= 0} {
                set is_hvc 1
            }
        }
        if {!$is_hvc} {
            continue
        }
        foreach geometry [odb::dbITerm_getGeometries $iterm] {
            set layer [lindex $geometry 0]
            if {[$layer getName] ne "met3"} {
                continue
            }
            set rect [lindex $geometry 1]
            set x [expr {int(([$rect xMin] + [$rect xMax]) / 2)}]
            set y [expr {int(([$rect yMin] + [$rect yMax]) / 2)}]
            set edge [tenon_sky130_bridge_edge $x $y $die_x0 $die_y0 $die_x1 $die_y1]
            tenon_sky130_attach_source $swire $m3 $m4 $m5 $m3m4 $m4m5 $width met3 $x $y $edge $left $bottom $right $top
            break
        }
    }
}

proc tenon_sky130_attach_io_met5 {block net_name swire m3 m4 m5 m3m4 m4m5 width left bottom right top die_x0 die_y0 die_x1 die_y1} {
    set net [$block findNet $net_name]
    foreach iterm [$net getITerms] {
        set instance_name [[$iterm getInst] getName]
        set is_io 0
        if {[string first "u_reference.u_padframe." $instance_name] == 0} {
            set is_io 1
        }
        if {!$is_io} {
            continue
        }
        foreach geometry [odb::dbITerm_getGeometries $iterm] {
            set layer [lindex $geometry 0]
            set layer_name [$layer getName]
            if {$layer_name ne "met4" && $layer_name ne "met5"} {
                continue
            }
            set rect [lindex $geometry 1]
            set x [expr {int(([$rect xMin] + [$rect xMax]) / 2)}]
            set y [expr {int(([$rect yMin] + [$rect yMax]) / 2)}]
            set edge [tenon_sky130_bridge_edge $x $y $die_x0 $die_y0 $die_x1 $die_y1]
            tenon_sky130_attach_source $swire $m3 $m4 $m5 $m3m4 $m4m5 $width $layer_name $x $y $edge $left $bottom $right $top
        }
    }
}


proc tenon_sky130_build_rail {block tech net_name margin_um connect_core} {
    set units [$block getDefUnits]
    set core $::tenon_sky130_bridge_core_area
    set die $::tenon_sky130_bridge_die_area
    set core_x0 [expr {int([lindex $core 0] * $units)}]
    set core_y0 [expr {int([lindex $core 1] * $units)}]
    set core_x1 [expr {int([lindex $core 2] * $units)}]
    set core_y1 [expr {int([lindex $core 3] * $units)}]
    set die_x0 [expr {int([lindex $die 0] * $units)}]
    set die_y0 [expr {int([lindex $die 1] * $units)}]
    set die_x1 [expr {int([lindex $die 2] * $units)}]
    set die_y1 [expr {int([lindex $die 3] * $units)}]
    set margin [expr {int($margin_um * $units)}]
    set width [expr {int(3.2 * $units)}]
    set left [expr {$core_x0 - $margin}]
    set bottom [expr {$core_y0 - $margin}]
    set right [expr {$core_x1 + $margin}]
    set top [expr {$core_y1 + $margin}]
    set net [$block findNet $net_name]
    if {$net eq "NULL"} {
        error "Missing Sky130 rail $net_name"
    }
    set swire [odb::dbSWire_create $net FIXED]
    set m3 [$tech findLayer met3]
    set m4 [$tech findLayer met4]
    set m5 [$tech findLayer met5]
    set m3m4 [$tech findVia M3M4_PR]
    set m4m5 [$tech findVia M4M5_PR]
    foreach object [list $m3 $m4 $m5 $m3m4 $m4m5] {
        if {$object eq "NULL"} {
            error "Sky130 bridge requires M3M4_PR and M4M5_PR technology vias"
        }
    }
    set io_clearance [expr {int(220 * $units)}]
    set io_x0 [expr {$die_x0 + $io_clearance}]
    set io_y0 [expr {$die_y0 + $io_clearance}]
    set io_x1 [expr {$die_x1 - $io_clearance}]
    set io_y1 [expr {$die_y1 - $io_clearance}]
    tenon_sky130_bridge_horizontal $swire $m5 $width $io_x0 $io_x1 $bottom
    tenon_sky130_bridge_horizontal $swire $m5 $width $io_x0 $io_x1 $top
    tenon_sky130_bridge_vertical $swire $m4 $width $left $io_y0 $io_y1
    tenon_sky130_bridge_vertical $swire $m4 $width $right $io_y0 $io_y1
    foreach x [list $left $right] {
        foreach y [list $bottom $top] {
            odb::dbSBox_create $swire $m4m5 $x $y STRIPE
        }
    }
    tenon_sky130_attach_bterms $block $net_name $swire $m3 $m4 $m5 $m3m4 $m4m5 $width $left $bottom $right $top $die_x0 $die_y0 $die_x1 $die_y1
    tenon_sky130_attach_hvc $block $net_name $swire $m3 $m4 $m5 $m3m4 $m4m5 $width $left $bottom $right $top $die_x0 $die_y0 $die_x1 $die_y1
    tenon_sky130_attach_io_met5 $block $net_name $swire $m3 $m4 $m5 $m3m4 $m4m5 $width $left $bottom $right $top $die_x0 $die_y0 $die_x1 $die_y1
    if {$connect_core} {
        set actual_core [$block getCoreArea]
        set actual_core_x0 [$actual_core xMin]
        set actual_core_y0 [$actual_core yMin]
        if {$net_name eq "vccd"} {
            set grid_x [expr {$actual_core_x0 + int(16.32 * $units)}]
            set grid_y [expr {$actual_core_y0 + int(16.65 * $units)}]
            tenon_sky130_bridge_horizontal $swire $m5 $width $left $grid_x $grid_y
            odb::dbSBox_create $swire $m4m5 $left $grid_y STRIPE
            odb::dbSBox_create $swire $m4m5 $grid_x $grid_y STRIPE
        } else {
            set grid_x [expr {$actual_core_x0 + int((16.32 + 3.2 + 1.7) * $units)}]
            set grid_y [expr {$actual_core_y0 + int((16.65 + 3.2 + 1.7) * $units)}]
            tenon_sky130_bridge_horizontal $swire $m5 $width $left $grid_x $grid_y
            odb::dbSBox_create $swire $m4m5 $left $grid_y STRIPE
            odb::dbSBox_create $swire $m4m5 $grid_x $grid_y STRIPE
        }
    }

}
set tenon_sky130_bridge_block [ord::get_db_block]
set tenon_sky130_bridge_tech [[ord::get_db] getTech]
foreach {net_name margin_um connect_core} {vccd 20 1 vssd 40 1 vddio 60 0 vssio 80 0} {
    tenon_sky130_build_rail $tenon_sky130_bridge_block $tenon_sky130_bridge_tech $net_name $margin_um $connect_core
}
